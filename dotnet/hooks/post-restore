#!/bin/bash
set -euo pipefail

environment="${ASPNETCORE_ENVIRONMENT:-Production}"
db_name="${environment,,}.sqlite3"
snapshot="/rails/storage/backups/$db_name"
db="/rails/storage/db/$db_name"

if [ -f "$snapshot" ]; then
  mkdir -p "$(dirname "$db")"
  cp "$snapshot" "$db"
  rm -f "$db-wal" "$db-shm"
fi
