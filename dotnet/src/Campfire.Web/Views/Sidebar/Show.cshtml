@inherits RazorSlice<SidebarModel>
@using Campfire.Web.Turbo
@* users/sidebars/show — loaded into the permanent user_sidebar frame *@
@{
    var ctx = Model.Page;
    var user = ctx.CurrentUser;
}
<turbo-frame id="user_sidebar" target="_top" @Raw(SidebarFrame.Attributes)>
  @TurboStreamFrom(StreamNames.Rooms)
  @TurboStreamFrom(StreamNames.UserRooms(user.Id))

  <div class="sidebar__container overflow-y overflow-hide-scrollbar"
      data-controller="badge-dot"
      data-badge-dot-unread-class="unread"
      data-action="rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize">
    <turbo-frame id="direct_rooms_control" target="_top">
      <div class="directs gap overflow-x overflow-hide-scrollbar">
        <a class="direct direct__new" data-turbo-frame="_self" href="@Paths.NewDirectRoom">
          <span class="avatar avatar--icon">
            @ImageTag("messages-add.svg", new Img(Size: 20, AriaHidden: true, Class: "colorize--black"))
          </span>

          <span class="direct__author flex max-width min-width border-radius pad-inline-half">
            <span class="for-screen-reader">New</span>
            <span class="txt-small overflow-clip">Ping</span>
          </span>
        </a>

        <div id="direct_rooms" contents data-controller="sorted-list" data-action="rooms-list:unread@window->sorted-list#updateItem">
          @foreach (var direct in Model.Directs)
          {
            @(await RenderPartialAsync<Campfire.Web.Views.Sidebar.Direct, DirectRoomView>(direct))
          }
        </div>

        <div contents>
          @foreach (var placeholder in Model.Placeholders)
          {
            @ButtonTo(Paths.DirectRoomsWith(placeholder.Id),
                Raw($"<span class=\"avatar\">{ImageTag(Paths.FreshUserAvatar(placeholder), new Img(AriaHidden: true)).Value}</span>" +
                    "<span class=\"direct__author flex align-center gap max-width min-width border-radius txt-small\"><span class=\"txt-nowrap overflow-ellipsis\">" +
                    $"<span class=\"for-screen-reader\">Start a ping with</span>{Escape(DirectRoomView.FirstName(placeholder.Name))}</span></span>"),
                cssClass: "direct borderless fill-transparent unpad", csrfToken: ctx.CsrfToken)
          }
        </div>
      </div>
    </turbo-frame>

    <div class="rooms position-relative flex flex-column gap">
      <div id="shared_rooms" contents data-controller="sorted-list">
        @foreach (var shared in Model.Shared)
        {
          @(await RenderPartialAsync<Campfire.Web.Views.Sidebar.Shared, SharedRoomView>(shared))
        }
      </div>

      @if (Model.CanCreateRooms)
      {
        <a class="rooms__new-btn btn room align-center gap txt-reversed" aria-label="New Chat Room" href="@Paths.NewOpenRoom">
          @ImageTag("add.svg", new Img(Size: 20, AriaHidden: true, Style: "view-transition-name: new-room"))
        </a>
      }
    </div>

    <button class="btn sidebar__toggle" data-action="toggle-class#toggle">
      @ImageTag("menu.svg", new Img(Size: 20, AriaHidden: true))
      <span class="for-screen-reader">Open menu</span>
    </button>
  </div>

  <div class="flex align-end sidebar__tools gap justify-end">
    <a class="btn avatar flex-item-no-shrink sidebar__tool" href="@Paths.UserProfile">
      @ImageTag(Paths.FreshUserAvatar(user), new Img(Size: 48, AriaHidden: true, Style: $"view-transition-name: avatar-{user.Id}"))
      <span class="for-screen-reader">My Settings</span>
    </a>

    <a class="btn align-center gap txt-reversed sidebar__tool" href="@Paths.EditAccount">
      @ImageTag("settings.svg", new Img(Size: 20, AriaHidden: true, Style: "view-transition-name: account-settings"))
      <span class="for-screen-reader">Account Settings</span>
    </a>
  </div>
</turbo-frame>
