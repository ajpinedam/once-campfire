@inherits RazorSlice<BoostView>
@* messages/boosts/_boost — broadcast and cached: no CSRF field (Turbo sends the header) *@
@{
    var boost = Model.Boost;
    var booster = Model.Booster;
    var deleteContent = Raw(ImageTag("minus.svg", new Img(Size: 20, AriaHidden: true)).Value + "<span class=\"for-screen-reader\">Delete this boost</span>");
}
<div id="@DomId.For(boost)"
    class="boost boost-item flex-inline postion--relative max-width align-center fill-white gap"
    data-controller="boost-delete" data-boost-delete-perform-class="boost--deleting" data-boost-delete-reveal-class="expanded" data-boost-delete-booster-id-value="@booster.Id">
  <figure class="avatar boost__avatar flex-item-no-shrink">
    @AvatarTag(booster, ariaLabel: $"{booster.Name} boosted {boost.Content}")
  </figure>

  <span role="button" class="@(Model.IsEmoji ? "txt-small txt-medium" : "txt-small")" data-action="click->boost-delete#reveal keydown.enter->boost-delete#reveal:prevent" data-boost-delete-target="content">@boost.Content</span>

  @ButtonTo(Paths.MessageBoost(boost.MessageId, boost.Id), deleteContent, method: "delete",
      cssClass: "btn btn--negative flex-item-justify-end boost__delete",
      buttonAttributes: "data-action=\"boost-delete#perform\" data-boost-delete-target=\"button\"")
</div>
<span id="delete_boost_accessible_label" class="for-screen-reader">Press enter to delete this boost</span>
