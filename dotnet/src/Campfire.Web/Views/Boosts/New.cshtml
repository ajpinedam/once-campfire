@inherits RazorSlice<NewBoostModel>
@* messages/boosts/new — loaded into the new_boost frame *@
@{
    var message = Model.Message;
    var user = Model.Page.CurrentUser;
}
<turbo-frame id="@DomId.For(message, "new_boost")">
  <div class="boost flex-inline postion--relative max-width fill-white" style="--column-gap: var(--inline-space-half)">
    <form class="boost__form flex align-center gap expanded" data-controller="form scroll-into-view" data-turbo-frame="@DomId.For(message, "boosting")" data-action="keydown.esc->form#cancel" action="@Paths.MessageBoosts(message.Id)" accept-charset="UTF-8" method="post">
      @CsrfField(Model.Page.CsrfToken)
      <label class="boost__form-label flex gap" style="--column-gap: 0.7ch;" role="button" tabindex="0" aria-label="Add a boost">
        <figure class="avatar boost__avatar flex-item-no-shrink">
          @AvatarTag(user)
          <span class="for-screen-reader">@user.Name</span>
        </figure>

        <input autofocus="autofocus" autocomplete="off" autocorrect="off" maxlength="16" required="required" pattern="\S+.*" data-boost-form-target="input" class="input input--boost txt-small" type="text" name="boost[content]" />
      </label>

      <button name="button" type="submit" class="btn btn--reversed">
        @ImageTag("check.svg", new Img(AriaHidden: true))
        <span class="for-screen-reader">Submit</span>
      </button>

      <a data-turbo-frame="@DomId.For(message, "boosts")" data-form-target="cancel" class="btn btn--negative" href="@Paths.MessageBoosts(message.Id)">
        @ImageTag("minus.svg", new Img(AriaHidden: true))
        <span class="for-screen-reader">Cancel</span>
      </a>
    </form>
  </div>
</turbo-frame>
