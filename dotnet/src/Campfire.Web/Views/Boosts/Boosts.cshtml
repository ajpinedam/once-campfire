@inherits RazorSlice<BoostsView>
@* messages/boosts/_boosts — part of the cached message fragment *@
@{
    var message = Model.Message;
}
<turbo-frame id="@DomId.For(message, "boosting")">
  <div class="boosts flex flex-wrap align-center gap full-width" style="--column-gap: 0.4ch; --row-gap: 0"
      data-controller="turbo-streaming" data-action="turbo:submit-start->turbo-streaming#unsubscribe">
    <div class="flex-inline flex-wrap gap" id="@DomId.For(message, "boosts")" data-turbo-streaming-target="container">
      @foreach (var boost in Model.Boosts)
      {
        @(await RenderPartialAsync<Campfire.Web.Views.Boosts.Boost, BoostView>(boost))
      }
    </div>

    <turbo-frame id="@DomId.For(message, "new_boost")">
      <div class="flex-inline message__boost-inline" data-controller="soft-keyboard">
        <a class="boost__action txt-small btn" data-action="soft-keyboard#open" href="@Paths.NewMessageBoost(message.Id)">
          @ImageTag("boost.svg", new Img(Size: 20, AriaHidden: true))
          <span class="for-screen-reader">Add a boost</span>
        </a>
      </div>
    </turbo-frame>
  </div>
</turbo-frame>
