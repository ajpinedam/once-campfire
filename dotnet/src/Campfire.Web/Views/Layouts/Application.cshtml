@inherits RazorLayoutSlice<LayoutModel>
@{
    var ctx = Model.Page;
    var logo = Paths.FreshAccountLogo(ctx.Account);
}
<!DOCTYPE html>
<html>
  <head>
    <title>@(Model.Title ?? "Campfire")</title>

    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="csrf-param" content="authenticity_token" />
    <meta name="csrf-token" content="@ctx.CsrfToken" />
    @if (ctx.User is { } user)
    {
    <meta name="current-user-id" content="@user.Id" />
    <meta name="current-user-name" content="@user.Name" />
    }
    <meta name="action-cable-url" content="@Paths.Cable" />
    <meta name="vapid-public-key" content="@ctx.VapidPublicKey" />
    <meta name="turbo-prefetch" content="true" />

    <link rel="manifest" href="@Paths.WebManifest" />
    <link rel="icon" href="@logo" type="image/png" />
    <link rel="apple-touch-icon" href="@logo" />

    @foreach (var stylesheet in AssetCatalog.Current.Stylesheets)
    {
    <link rel="stylesheet" href="@AssetPath(stylesheet)" data-turbo-track="reload" />
    }
    @if (ctx.Account?.CustomStyles is { Length: > 0 } customStyles)
    {
    <style data-turbo-track="reload">@Raw(customStyles)</style>
    }

    @Raw(AssetCatalog.Current.ImportMap.Html)

    @await RenderSectionAsync("head")
  </head>

  <body class="@Model.BodyClasses" data-controller="local-time lightbox">
    <a href="#main-content" class="skip-navigation btn">Skip to main content</a>

    <nav id="nav">
      @await RenderSectionAsync("nav")
    </nav>

    @if (ctx.Flash is { Message: { } message } flash)
    {
    <div class="flash" data-controller="element-removal" data-action="animationend->element-removal#remove">
      <div class="flash__inner shadow" style="@(flash.IsAlert ? "--flash-background: var(--color-negative)" : null)">
        @if (flash.IsAlert)
        {
          @ImageTag("alert.svg", new Img(Size: 24, AriaHidden: true, Class: "colorize--white"))
        }
        else
        {
          @ImageTag("check.svg", new Img(Size: 24, AriaHidden: true, Class: "colorize--white"))
        }
      </div>
      <span class="for-screen-reader" role="alert" aria-atomic="true">@message</span>
    </div>
    }

    <main id="main-content">
      @await RenderBodyAsync()

      <footer id="footer">
        @await RenderSectionAsync("footer")
      </footer>
    </main>

    <aside id="sidebar" data-controller="toggle-class" data-toggle-class-toggle-class="open">
      @await RenderSectionAsync("sidebar")
    </aside>

    <dialog class="lightbox" aria-label="Image Viewer (Press escape to close)" data-lightbox-target="dialog" data-action="close->lightbox#reset">
      <img src="" class="lightbox__image" data-lightbox-target="zoomedImage" />

      <form method="dialog" class="lightbox__btn">
        <button class="btn">
          @ImageTag("remove.svg", new Img(AriaHidden: true))
          <span class="for-screen-reader">Close image viewer</span>
        </button>
      </form>

      <a href="" class="lightbox__btn--download btn hide-in-ios-pwa" data-lightbox-target="download">
        @ImageTag("download.svg", new Img(AriaHidden: true))
        <span class="for-screen-reader">Download file</span>
      </a>

      <button class="lightbox__btn--share btn"
          data-controller="web-share"
          data-action="web-share#share"
          data-web-share-files-value=""
          data-lightbox-target="share">
        @ImageTag("share.svg", new Img(AriaHidden: true))
        <span class="for-screen-reader">Share file</span>
      </button>
    </dialog>

    <a href="https://once.com" id="app-logo" target="_blank" aria-label="Once software from 37signals home page">
      @ImageTag("campfire-icon.png", new Img(Alt: "Campfire logo", Width: 256, Height: 216))
    </a>
  </body>
</html>
