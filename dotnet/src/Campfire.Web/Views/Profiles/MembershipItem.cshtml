@inherits RazorSlice<ProfileMembership>
<li class="flex align-center gap margin-none min-width membership-item">
  <a class="overflow-ellipsis fill-shade txt-primary txt-undecorated" href="@Paths.Room(Model.Room.Id)">
    <strong>@Model.DisplayName</strong>
  </a>

  <hr class="separator" aria-hidden="true">

  <span class="txt-small">
    <turbo-frame id="@DomId.For(Model.Room, "involvement")">
      @Involvements.ButtonToChange(Model.Room, Model.Involvement, Model.Page.CsrfToken)
    </turbo-frame>
  </span>
</li>
