@inherits RazorSlice<CustomStylesModel>
@implements IUsesLayout<Campfire.Web.Views.Layouts.Application, LayoutModel>
<section class="panel panel--wide txt-align-center flex flex-column position-relative" style="view-transition-name: custom-styles">
  <form class="flex flex-column gap" data-controller="form" data-action="keydown.ctrl+enter->form#submit keydown.meta+enter->form#submit" action="@Paths.AccountCustomStyles" accept-charset="UTF-8" method="post">
    @MethodField("patch")@CsrfField(Model.Page.CsrfToken)
    <div class="panel__button">
      @TranslationButton("custom_styles")
    </div>

    <div class="pad-inline-double margin-inline">
      <h1 class="margin-none">Custom CSS</h1>
      <p class="flex flex-wrap align-center justify-center gap margin-none-block-start" style="--column-gap: 0.5ch; --row-gap: 0">
        <span>Add custom CSS styles.</span>
        @ImageTag("alert.svg", new Img(Size: 16, AriaHidden: true, Class: "flex-inline colorize--black"))
        <span>Use Caution: you could break things.</span>
      </p>
    </div>

    <label class="flex align-start gap flex-item-grow">
      <textarea class="input input--code txt--small" placeholder="Add CSS styles…" autocomplete="off" spellcheck="false" autocorrect="off" autocapitalize="off" rows="16" name="account[custom_styles]" id="account_custom_styles">
@Model.Account.CustomStyles</textarea>
    </label>

    <button class="btn btn--reversed center txt-large" type="submit">
      @ImageTag("check.svg", new Img(Size: 20, AriaHidden: true))
      <span class="for-screen-reader">Save changes</span>
    </button>
  </form>
</section>

@functions {
    public LayoutModel LayoutModel => new(Model.Page, Title: "Custom styles");

    protected override Task ExecuteSectionAsync(string name)
    {
        if (name == "nav")
        {
            <div class="flex-item-justify-start">
              @LinkBackTo(Paths.EditAccount)
            </div>
        }
        return Task.CompletedTask;
    }
}
