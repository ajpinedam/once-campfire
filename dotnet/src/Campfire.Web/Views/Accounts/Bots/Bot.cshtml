@inherits RazorSlice<BotEntry>
@{
    var bot = Model.Bot;
}
<li class="flex flex-column gap flush fill-shade border-radius pad-block pad-inline-double">
  <div class="flex align-center gap">
    <figure class="avatar flex-item--no-shrink" style="--avatar-size: 2.65em;">
      @AvatarTag(bot, loading: "lazy")
    </figure>

    <div class="min-width">
      <div class="overflow-ellipsis txt-large"><strong>@bot.Name</strong></div>
    </div>

    <a class="btn flex-item-justify-end" style="view-transition-name: chat-bot-@bot.Id" href="@Paths.EditAccountBot(bot.Id)">
      @ImageTag("pencil.svg", new Img(Size: 20, AriaHidden: true))
      <span class="for-screen-reader">Edit @bot.Name</span>
    </a>
  </div>

  @foreach (var room in Model.Rooms)
  {
    var messagesUrl = Model.Page.Url(Paths.RoomBotMessages(room.Id, bot.BotKey));
    var curlTextLine = $"curl -d 'Hello!' {messagesUrl}";
    var curlUploadLine = $"curl -F \"attachment=@/path/to/file\" {messagesUrl}";

    <fieldset class="gap max-width pad border border-radius">
      <legend class="min-width txt-align-start pad-inline">
        <strong class="overflow-ellipsis">@room.Name</strong>
      </legend>

      <div class="flex align-center gap">
        @ImageTag("messages-outlined.svg", new Img(Size: 24, AriaHidden: true, Class: "colorize--black"))

        <div class="flex-item-grow">
          <input type="text" class="input full-width fill-white" value="@curlTextLine" aria-label="curl command for posting messages" readonly>
        </div>

        <div class="txt-small">
          <button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="@curlTextLine">
            @ImageTag("copy-paste.svg", new Img(Size: 20, AriaHidden: true))
            <span class="for-screen-reader">Copy message command</span>
          </button>
        </div>
      </div>

      <div class="flex align-center gap">
        @ImageTag("attachment.svg", new Img(Size: 24, AriaHidden: true, Class: "colorize--black"))

        <div class="flex-item-grow">
          <input type="text" class="input full-width fill-white" value="@curlUploadLine" aria-label="curl command for posting attachments" readonly>
        </div>

        <div class="txt-small">
          <button class="btn" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="@curlUploadLine">
            @ImageTag("copy-paste.svg", new Img(Size: 20, AriaHidden: true))
            <span class="for-screen-reader">Copy attachment command</span>
          </button>
        </div>
      </div>
    </fieldset>
  }
</li>
