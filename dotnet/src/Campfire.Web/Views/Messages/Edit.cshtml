@inherits RazorSlice<EditMessageModel>
@* messages/edit — loaded into the message's edit frame *@
@{
    var message = Model.Message;
    var messagePath = Paths.RoomMessage(message.RoomId, message.Id);
    var deleteForm = DomId.For(message, "delete_form");
}
<turbo-frame id="@DomId.For(message, "edit")">
  <div class="message__body position-relative" data-controller="scroll-into-view">
    <div class="message__body-content message__body-content--editing gap">
      @if (Model.AttachmentPresentation is { } attachmentPresentation)
      {
        @attachmentPresentation

        <div class="message__edit-btns flex align-center justify-space-between gap full-width pad-block-start-half">
          <button name="button" type="submit" class="btn btn--negative center margin-block-end" form="@deleteForm" data-turbo-confirm="Are you sure you want to delete this message?">
            @ImageTag("trash.svg", new Img(AriaHidden: true))
            <span class="for-screen-reader">Delete message</span>
          </button>
        </div>
      }
      else
      {
        <div class="composer--edit composer--rich-text">
          <form id="@DomId.For(message, "form")" data-controller="form" data-action="lexxy:file-accept->form#preventAttachment keydown.esc->form#cancel keydown.ctrl+enter->form#submit:prevent keydown.meta+enter->form#submit:prevent" action="@messagePath" accept-charset="UTF-8" method="post">
            @MethodField("patch")
            @CsrfField(Model.Page.CsrfToken)
            <div class="full-width input input--actor min-width fill-white">
              <lexxy-editor name="message[body]" id="message_body" value="@Model.EditableBody" rows="1" class="input lexxy-content" aria-multiline="true" aria-label="Edit message" autofocus="autofocus" permitted-attachment-types="application/vnd.campfire.mention application/vnd.actiontext.opengraph-embed" data-action="lexxy:change->typing-notifications#start keydown->composer#submitByKeyboard:capture">
                <lexxy-prompt trigger="@@" name="mention" src="@Paths.AutocompletableUsersInRoom(message.RoomId)" remote-filtering="true" empty-results="No matches"></lexxy-prompt>
              </lexxy-editor>
            </div>

            <a data-form-target="cancel" hidden="hidden" href="@messagePath">Close editor and discard changes</a>

            <div class="message__edit-btns flex align-center justify-space-between gap full-width pad-block-start-half">
              <button name="button" type="submit" class="btn btn--reversed">
                @ImageTag("check.svg", new Img(AriaHidden: true))
                <span class="for-screen-reader">Save changes</span>
              </button>

              <button name="button" type="submit" class="btn btn--negative" form="@deleteForm" data-turbo-confirm="Are you sure you want to delete this message?">
                @ImageTag("trash.svg", new Img(AriaHidden: true))
                <span class="for-screen-reader">Delete message</span>
              </button>
            </div>
          </form>
        </div>
      }
    </div>

    <div class="message__actions flex flex-wrap">
      <a class="message__action-btn message__edit-close-btn txt-small btn btn--borderless" href="@messagePath">
        @ImageTag("remove.svg", new Img(Class: "colorize--black", AriaHidden: true))
        <span class="for-screen-reader">Close editor and discard changes</span>
      </a>
    </div>

    <form id="@deleteForm" data-turbo-frame="@DomId.For(message, "edit")" action="@messagePath" accept-charset="UTF-8" method="post">
      @MethodField("delete")
      @CsrfField(Model.Page.CsrfToken)
    </form>
  </div>
</turbo-frame>
